{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "[default debug]",
            "request": "launch",
            "type": "dart",
            "flutterMode": "debug",
            "args": [
                "--target",
                "lib/main.dart",
                "--dart-define-from-file",
                ".env"
            ]
        },
        {
            "name": "[dev android]",
            "request": "launch",
            "type": "dart",
            "flutterMode": "debug",
            "program": "lib/main.dart",
            "args": [
                "--flavor",
                "development",
                "--target",
                "lib/main.dart",
                "--dart-define-from-file",
                ".env"
            ]
        },
        {
            "name": "[stag android]",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile",
            "program": "lib/main.dart",
            "args": [
                "--flavor",
                "staging",
                "--target",
                "lib/main.dart",
                "--dart-define-from-file",
                ".env"
            ]
        },
        {
            "name": "[prod android]",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release",
            "program": "lib/main.dart",
            "args": [
                "--flavor",
                "production",
                "--target",
                "lib/main.dart",
                "--dart-define-from-file",
                ".env"
            ]
        },
    ]
}